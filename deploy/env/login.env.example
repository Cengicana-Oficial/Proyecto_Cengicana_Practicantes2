DB_HOST=mysql
DB_PORT=3306
DB_NAME=usuarios_menu
DB_USER=modulos_user
DB_PASS=change-me

# Envio de correos (SMTP2GO) para el flujo "olvide mi contrasena"
# (login/forgot_password.php -> login/reset_password.php, ver
# login/config/correo.php). Mismas variables/valores que
# deploy/env/cengicursos.env, MAIL_FROM_ADDRESS debe ser un remitente o
# pertenecer a un dominio verificado en la cuenta de SMTP2GO. SMTP2GO
# recomienda STARTTLS y el puerto 2525 para mayor compatibilidad.
MAIL_HOST=mail.smtp2go.com
MAIL_PORT=2525
MAIL_USERNAME=change-me
MAIL_PASSWORD=change-me
MAIL_FROM_ADDRESS=change-me
MAIL_FROM_NAME=CENGICANA

# Puente de SSO hacia SIGEC (login/sso_sigec.php -> experimentos/routes/web.php
# "/sso/entrar"). SIGEC_URL es la URL publica bajo la que SIGEC responde
# (mismo dominio del compendio, via el proxy interno del contenedor "app",
# ver dockerfiles/modulos-app/sigec-proxy.conf) — debe coincidir con
# APP_URL de deploy/env/sigec.env. SIGEC_SSO_SECRET debe coincidir byte a
# byte con el mismo valor en deploy/env/sigec.env.
SIGEC_URL=https://modulos.cengicana.org/sigec
SIGEC_SSO_SECRET=change-me

# Comites (comites/ lee este archivo). COMITES_SECRET_KEY cifra las credenciales de
# redes sociales (Meta, LinkedIn, GA4) guardadas en redes_conexiones; es obligatoria para
# guardarlas. Generar con: php -r "echo bin2hex(random_bytes(32));"  y no cambiarla despues
# (las credenciales guardadas dejarian de poder leerse y habria que conectarlas de nuevo).
COMITES_SECRET_KEY=change-me
# Base del modulo Solicitudes internas (Comites la consulta). Por defecto: sistema_solicitudes.
DB_SOLICITUDES_NAME=sistema_solicitudes
# Base publica del boton "Ver solicitud" en los correos de Solicitudes internas (lee este archivo en
# produccion). Vacia se usaria la cabecera Host de la peticion (AUD-2026-001/M-3).
SOLICITUDES_URL=https://modulos.cengicana.org/sistema_de_solicitudes

