# Base compartida del login/menu.
DB_MENU_HOST=mysql
DB_MENU_PORT=3306
DB_MENU_NAME=usuarios_menu
DB_MENU_USER=modulos_user
DB_MENU_PASS=change-me

# Base local del modulo de cursos.
CENGICURSOS_DB_HOST=mysql
CENGICURSOS_DB_PORT=3306
CENGICURSOS_DB_NAME=cengi_cursos
CENGICURSOS_DB_USER=modulos_user
CENGICURSOS_DB_PASS=change-me

# Envio de correos (Brevo SMTP). BREVO_FROM_EMAIL debe ser un remitente
# verificado en la cuenta de Brevo (idealmente un correo del dominio
# cengicana.org) o el proveedor rechazara/descartara los envios.
# BREVO_SMTP_HOST usa el hostname legado "sendinblue.com" (mismo servicio):
# "smtp-relay.brevo.com" puede resolver a un backend cuyo certificado TLS no
# cubre ese nombre y PHP rechaza el handshake (ver cengicursos/correo.php).
BREVO_SMTP_HOST=smtp-relay.sendinblue.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=change-me
BREVO_SMTP_KEY=change-me
BREVO_FROM_EMAIL=change-me
BREVO_FROM_NAME=CENGICANA

# Token secreto para disparar cengicursos/cron_recordatorio_cupo.php via HTTP
# (?token=...), por si se programa desde un servicio externo tipo cron-job.org
# en vez de un cron de servidor/CLI. No hace falta si solo se ejecuta por CLI.
CRON_RECORDATORIO_SECRET=change-me

