# Base de datos propia del modulo Laboratorio (esquema en
# laboratorio/database/laboratorios_prueba.sql). Comparte el mismo servidor
# MySQL y usuario que los demas modulos (ver deploy/env/cengicursos.env.example),
# solo cambia DB_NAME.
DB_HOST=mysql
DB_PORT=3306
DB_NAME=laboratorios_prueba
DB_USER=modulos_user
DB_PASSWORD=change-me

# URL pública del sitio para los QR de verificación de boletas e informes
# (laboratorio/validar.php). Debe ser la dirección que abre el cliente desde su celular, p. ej.
# https://modulos.cengicana.org. Vacía = se usa la del pedido actual (sirve solo en local).
LAB_PUBLIC_URL=

# Clave del tablero de avance para pantalla (view/tablero_laboratorio.php?k=<clave>).
# Se abre sin iniciar sesion y es de solo lectura. Minimo 16 caracteres; vacia =
# tablero deshabilitado. Cambiarla revoca los enlaces ya compartidos.
# Generar con: php -r "echo bin2hex(random_bytes(24));"
LAB_TABLERO_TOKEN=

# Base de SIGEC/Experimentos que Laboratorio lee directamente (mismo servidor y
# usuario; el usuario necesita SELECT sobre ella). Vacia = "sigec".
EXPERIMENTOS_DB_NAME=sigec

# Opcionales: URLs de inicio y cierre de sesion. Vacias = se usan MAIN_LOGIN_URL /
# MAIN_LOGOUT_URL o, si tampoco existen, las rutas relativas del portal.
LAB_AUTH_LOGIN_URL=
LAB_AUTH_LOGOUT_URL=
