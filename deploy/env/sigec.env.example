APP_NAME=SIGEC
APP_ENV=production
# Generar con: docker compose exec -u www-data sigec php artisan key:generate --show
# (correrlo una vez tras el primer build y pegar el valor aqui). Importante:
# usar siempre -u www-data en comandos artisan manuales (migrate, db:seed,
# key:generate, etc.) — sin eso, `docker exec` corre como root por defecto
# (la imagen no fija USER) y deja archivos root-owned en storage/framework
# y bootstrap/cache que despues bloquean las peticiones web normales
# (corren como www-data) con "Unable to create lockable file" / 500. Si ya
# ocurrio, corregir con:
# docker compose exec -u root sigec chown -R www-data:www-data storage bootstrap/cache
APP_KEY=
APP_DEBUG=false
# SIGEC se sirve bajo el mismo dominio del compendio (modulos.cengicana.org),
# via el proxy interno del contenedor "app" (ver
# dockerfiles/modulos-app/sigec-proxy.conf) — no un subdominio propio.
# APP_URL debe incluir el prefijo /sigec completo: de eso depende que
# url()/asset()/route() generen enlaces correctos (ver
# App\Providers\AppServiceProvider::boot()).
APP_URL=https://modulos.cengicana.org/sigec

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sigec
DB_USERNAME=modulos_user
DB_PASSWORD=change-me

# v1 no usa Redis/Horizon (se difiere, ver plan de integracion): sesion y
# cache en archivo local del contenedor, cola sincronica.
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Cookie de sesion acotada a /sigec (no todo el dominio compartido) y
# marcada Secure explicitamente: no dependemos de que el proxy interno
# reenvie encabezados X-Forwarded-Proto para que Laravel detecte HTTPS.
SESSION_PATH=/sigec
SESSION_SECURE_COOKIE=true
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DRIVER=local

# Envio de correos (SMTP2GO), mismo proveedor que cengicursos.env.example.
# MAIL_FROM_ADDRESS debe ser un remitente o pertenecer a un dominio
# verificado en la cuenta de SMTP2GO.
MAIL_MAILER=smtp
MAIL_HOST=mail.smtp2go.com
MAIL_PORT=2525
MAIL_USERNAME=change-me
MAIL_PASSWORD=change-me
MAIL_FROM_ADDRESS=change-me
MAIL_FROM_NAME=SIGEC

# Secreto compartido para firmar/validar el token del puente SSO desde
# login/sso_sigec.php. Debe coincidir byte a byte con SIGEC_SSO_SECRET en
# deploy/env/login.env.
SIGEC_SSO_SECRET=change-me
