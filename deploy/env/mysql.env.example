MYSQL_ROOT_PASSWORD=change-root-password
MYSQL_DATABASE=usuarios_menu
MYSQL_USER=modulos_user
MYSQL_PASSWORD=change-me
# Usuario de migraciones (modulos_migrador): crea y altera tablas al desplegar. modulos_user
# queda solo con permisos de datos (deploy/mysql/init/62-permisos-modulos.sh, AUD-2026-001/I-2).
MIGRADOR_PASSWORD=change-migrador-password

# Usuario de solo lectura de SIGEC sobre la base del modulo Laboratorio
# (misma contrasena que LAB_DB_PASSWORD en sigec.env).
SIGEC_LAB_LECTURA_PASSWORD=change-me
