# Modulo "Solicitud de visitas" / "Servicio tecnico" (carpeta Pruebas/).
# Se monta como Pruebas/.env dentro del contenedor "app" (ver
# docker-compose.prod.yml). Copiar a deploy/env/visitas.env y ajustar valores.

# Base propia del modulo (esquema en deploy/mysql/init/17-visitas-schema.sql).
# Comparte servidor MySQL y usuario con los demas modulos; solo cambia DB_NAME.
DB_HOST=mysql
DB_PORT=3306
DB_NAME=cengi_visitas
DB_USER=modulos_user
# Pruebas/config/conexion.php lee DB_PASS y, si falta, DB_PASSWORD.
DB_PASS=change-me
DB_PASSWORD=change-me

# Base compartida del login/menu (usuarios, roles, permisos, modulos).
DB_MENU_HOST=mysql
DB_MENU_PORT=3306
DB_MENU_NAME=usuarios_menu
DB_MENU_USER=modulos_user
DB_MENU_PASS=change-me

# Envio de correos de confirmacion/aprobacion/rechazo de solicitudes de visita
# (Pruebas/public/procesar_solicitud.php y public/admin/enviar_correo.php usan
# STARTTLS). Mismas credenciales SMTP2GO que cengicursos.env si aplica.
MAIL_HOST=mail.smtp2go.com
MAIL_PORT=2525
MAIL_USER=change-me
MAIL_PASS=change-me
MAIL_NAME=CENGICANA
