.git
.gitignore
**/.env
deploy/env/*.env
**/vendor
# experimentos/public/vendor y experimentos/resources/lang/vendor NO son dependencias de
# composer: son assets de aplicacion (AdminLTE/FontAwesome/jQuery
# publicados, traducciones del paquete adminlte) trackeados en git y
# necesarios en build. **/vendor de arriba los excluiria por nombre si no
# fuera por estas excepciones.
!experimentos/public/vendor
!experimentos/public/vendor/**
!experimentos/resources/lang/vendor
!experimentos/resources/lang/vendor/**
**/node_modules
**/_Respaldo
# Prototipos y plantillas de referencia del equipo: no los usa la aplicacion y Apache los
# serviria como estaticos sin sesion (AUD-2026-001/C-1).
Prototipos
Pruebas/uploads
laboratorio/outputs
*.sql.gz
# Archivos que suben los usuarios: en produccion se montan como volumen (docker-compose.prod.yml),
# no van dentro de la imagen. Se conservan las carpetas (.gitkeep) y uploads/.htaccess.
uploads/**
!uploads/.htaccess
!uploads/**/.gitkeep
sistema_de_solicitudes/uploads/**
!sistema_de_solicitudes/uploads/.gitkeep
# Respaldos de la base que genera deploy/mysql/actualizar-bd.sh (datos reales)
respaldos
