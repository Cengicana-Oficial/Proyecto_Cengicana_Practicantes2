# Avisos por correo (usa el SMTP MAIL_* de login/.env).
# 0 = solo campana dentro del sistema, sin correos.
SOLICITUDES_CORREO_ACTIVO=1
# Base publica para el boton "Ver solicitud" del correo. Configurarla en produccion: vacia se usa la
# cabecera Host de la peticion, que controla el cliente (AUD-2026-001/M-3).
SOLICITUDES_URL=https://modulos.cengicana.org/sistema_de_solicitudes
