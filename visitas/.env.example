# Configuracion unica de Supabase para el modulo de visitas.
# Copia este archivo como .env y completa los valores locales.

VISITS_DB_DRIVER=pgsql

# Session pooler de Supabase (Connect > Session pooler).
VISITS_DB_HOST=aws-0-region.pooler.supabase.com
VISITS_DB_PORT=5432
VISITS_DB_NAME=postgres
VISITS_DB_USER=postgres.project-ref
VISITS_DB_PASS=clave_de_base_de_datos
VISITS_DB_SSLMODE=require

# Solo para PHP y Supabase Storage. Nunca lo coloques en JavaScript.
SUPABASE_URL=https://project-ref.supabase.co
# Recomendado: clave secreta nueva de servidor (sb_secret_...).
# Alternativa heredada: SUPABASE_SERVICE_ROLE_KEY=eyJ... (JWT).
SUPABASE_SECRET_KEY=sb_secret_REEMPLAZAR
# SUPABASE_SERVICE_ROLE_KEY=eyJ_REEMPLAZAR_CON_SERVICE_ROLE_JWT

# URL pública base para los enlaces del formulario de visitantes.
# En local puede ser: http://127.0.0.1:8085/visitas
VISITS_PUBLIC_URL=http://127.0.0.1:8085/visitas

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=correo@example.com
MAIL_PASS=clave_correo
MAIL_NAME=CENGICANA
